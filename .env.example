# Interface to randomize (default: en0 on macOS, wlan0 on Linux)
NETWORK_INTERFACE=
# watch: also rotate every N seconds while connected (0 = off)
ROTATE_INTERVAL=0
# watch: seconds between network checks
POLL_SECONDS=3

# session: path to your WireGuard (wg-quick) config. Required for `session start`.
# The file must be mode 0600 and owned by root or by you. The private key stays
# in that file; never put it here.
WG_CONFIG=
# session: optional second config (another server, on a different port), tried
# once if the first does not connect within 15 seconds.
WG_CONFIG_FALLBACK=
# session: strict mode. 1 (default) = on a confirmed hostile-network finding,
# stop the tunnel and block all traffic until `session stop`. 0 = only warn.
# --strict / --no-strict on the command line override this.
STRICT=1
# session: which findings trigger strict mode, comma-separated. Leave empty for
# the default: arp_spoof_suspected,arp_conflict,network_reconfigured
# (possible_evil_twin is also available; it only warns by default).
STRICT_ON=
